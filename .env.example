# Vleeds environment configuration
# Copy to .env.local (git-ignored) and fill in. Never commit real values.
#
# ── Browser-safe (inlined into the client bundle) ─────────────────────────────
# Only the Supabase URL and PUBLISHABLE (anon) key may be NEXT_PUBLIC_.
# All data access is authorized by Postgres Row Level Security.
#
# Local stack:  `npx supabase start`, then `npx supabase status` prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Server-only secrets ───────────────────────────────────────────────────────
# Server-only secrets (provider keys, the service-role key below, future calling
# provider credentials) must:
#   - never use the NEXT_PUBLIC_ prefix,
#   - only be read from modules that `import "server-only"`,
#   - be added to scripts/check-client-bundle.mjs so the build check guards them.

# Trusted score writer (P1-E7): the ONLY use of the service-role key. Lead scores
# are persisted by public.save_lead_score_trusted, which the normal authenticated
# role cannot execute; the server authenticates the user, evaluates, then writes
# through src/lib/supabase/trusted-score-writer.ts. Without it, evaluating fit and
# "Refresh lead scores" report that the score writer isn't configured.
# Local stack: `npx supabase status` prints it (service_role / secret key).
# Never prefix with NEXT_PUBLIC_, never log it, never use it for anything else.
# SUPABASE_SERVICE_ROLE_KEY=

# Company discovery (P1-E3): Google Places API (New), server-only.
# Optional: without it, Discover shows "Company discovery is not configured yet."
# Setup: docs/providers/google-places.md. Never prefix with NEXT_PUBLIC_.
# GOOGLE_PLACES_API_KEY=
#
# Development / UI review ONLY: send Places requests to a local mock instead of
# Google. Ignored unless the host is loopback, and ignored on Vercel production.
# GOOGLE_PLACES_ENDPOINT=http://127.0.0.1:54321/v1/places:searchText

# Company enrichment (P1-E4): Hunter API v2, server-only. Sent as the X-API-KEY header.
# Optional: without it, Vleeds shows "Company enrichment is not configured yet."
# Setup: docs/providers/hunter.md. Never prefix with NEXT_PUBLIC_.
# HUNTER_API_KEY=
#
# Development / UI review ONLY: base URL (…/v2) of a local mock instead of Hunter.
# Ignored unless the host is loopback, and ignored on Vercel production.
# HUNTER_API_ENDPOINT=http://127.0.0.1:54321/hunter/v2

# ── Tests ─────────────────────────────────────────────────────────────────────
# Optional. When set, `npm run test:db` runs the tenant-isolation suite against
# this Postgres (e.g. the local Supabase stack) instead of embedded PGlite.
# SUPABASE_TEST_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Local development login ───────────────────────────────────────────────────
# LOCAL STACK ONLY. Read by scripts/dev/create-local-test-user.mjs (needs
# SUPABASE_SERVICE_ROLE_KEY above). Password: at least 12 characters. Values
# belong in .env.local only.
# VLEEDS_LOCAL_TEST_EMAIL=
# VLEEDS_LOCAL_TEST_PASSWORD=
